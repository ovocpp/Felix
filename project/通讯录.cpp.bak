#include<iostream>
using namespace std;

void showMenu()
{   cout << "**************************" << endl;
    cout << "*****  1.添加联系人  *****" << endl;
    cout << "*****  2.显示联系人  *****" << endl;
    cout << "*****  3.删除联系人  *****" << endl;
    cout << "*****  4.查找联系人  *****" << endl;
    cout << "*****  5.修改联系人  *****" << endl;
    cout << "*****  6.清空联系人  *****" << endl;
    cout << "*****  0.退出通讯录  *****" << endl;
    cout << "**************************" << endl;

}
int main()
{
    showMenu();
    int select = 0;
    cin >> select;

    switch (select)
    {
        case1:
            cout << "添加联系人" << endl;
            break;
        case2:
            cout << "显示联系人" << endl;  
            break;
        case3:
            cout << "删除联系人" << endl;
            break;
        case4:
            cout << "查找联系人" << endl;
            break;
        case5:
            cout << "修改联系人" << endl;
            break;
        case6:
            cout << "清空联系人" << endl;
            break;
        case0:
            cout << "欢迎下次使用！" << endl;
            break;
        default:
            cout << "输入有误，请重新输入！" << endl;
            break;
    }
 
    system("pause");
    return 0;
}